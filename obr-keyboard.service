[Unit]
Description=OBR braille keyboard (ESP32 on USB) -> spoken sentences
After=sound.target

[Service]
# set for user "admin" with the project in /home/admin/obr (change if yours differ)
User=admin
WorkingDirectory=/home/admin/obr
ExecStart=/usr/bin/python3 /home/admin/obr/braille_keyboard.py
Restart=on-failure
RestartSec=3
# lets espeak-ng reach the user's audio
Environment=XDG_RUNTIME_DIR=/run/user/1000

[Install]
WantedBy=multi-user.target
